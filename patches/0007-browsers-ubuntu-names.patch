diff --git a/bin/omarchy-default-browser b/bin/omarchy-default-browser
index e7ed21d..16099c3 100755
--- a/bin/omarchy-default-browser
+++ b/bin/omarchy-default-browser
@@ -13,7 +13,7 @@ if (($# == 0)); then
   brave-origin.desktop) echo "brave-origin" ;;
   microsoft-edge.desktop) echo "edge" ;;
   firefox.desktop) echo "firefox" ;;
-  zen.desktop) echo "zen" ;;
+  app.zen_browser.zen.desktop) echo "zen" ;;
   *) echo "$current_browser" ;;
   esac
   exit 0
@@ -26,7 +26,7 @@ brave) desktop_id="brave-browser.desktop"; name="Brave"; glyph=󰖟 ;;
 brave-origin) desktop_id="brave-origin.desktop"; name="Brave Origin"; glyph=󰖟 ;;
 edge) desktop_id="microsoft-edge.desktop"; name="Edge"; glyph=󰇩 ;;
 firefox) desktop_id="firefox.desktop"; name="Firefox"; glyph=󰈹 ;;
-zen) desktop_id="zen.desktop"; name="Zen"; glyph=󰖟 ;;
+zen) desktop_id="app.zen_browser.zen.desktop"; name="Zen"; glyph=󰖟 ;;
 *)
   echo "Usage: omarchy-default-browser <chromium|chrome|brave|brave-origin|edge|firefox|zen>"
   exit 1
