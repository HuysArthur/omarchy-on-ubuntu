diff --git a/bin/omarchy-default-browser b/bin/omarchy-default-browser
index 5328d86..4fe2816 100755
--- a/bin/omarchy-default-browser
+++ b/bin/omarchy-default-browser
@@ -19,27 +19,29 @@ if (($# == 0)); then
   brave-origin.desktop) echo "brave-origin" ;;
   microsoft-edge.desktop) echo "edge" ;;
   firefox.desktop) echo "firefox" ;;
-  zen.desktop) echo "zen" ;;
+  app.zen_browser.zen.desktop) echo "zen" ;;
   *) echo "$current_browser" ;;
   esac
   exit 0
 fi
 
 case "$1" in
-chromium) browser="chromium"; command="chromium"; desktop_id="chromium.desktop"; name="Chromium"; glyph= ;;
-chrome) browser="chrome"; command="google-chrome-stable"; desktop_id="google-chrome.desktop"; name="Chrome"; glyph=󰊯 ;;
-brave) browser="brave"; command="brave"; desktop_id="brave-browser.desktop"; name="Brave"; glyph=󰖟 ;;
-brave-origin) browser="brave-origin"; command="brave-origin"; desktop_id="brave-origin.desktop"; name="Brave Origin"; glyph=󰖟 ;;
-edge) browser="edge"; command="microsoft-edge-stable"; desktop_id="microsoft-edge.desktop"; name="Edge"; glyph=󰇩 ;;
-firefox) browser="firefox"; command="firefox"; desktop_id="firefox.desktop"; name="Firefox"; glyph=󰈹 ;;
-zen) browser="zen"; command="zen-browser"; desktop_id="zen.desktop"; name="Zen"; glyph=󰖟 ;;
+chromium) browser="chromium"; package="chromium"; desktop_id="chromium.desktop"; name="Chromium"; glyph= ;;
+chrome) browser="chrome"; package="google-chrome"; desktop_id="google-chrome.desktop"; name="Chrome"; glyph=󰊯 ;;
+brave) browser="brave"; package="brave-bin"; desktop_id="brave-browser.desktop"; name="Brave"; glyph=󰖟 ;;
+brave-origin) browser="brave-origin"; package="brave-origin-bin"; desktop_id="brave-origin.desktop"; name="Brave Origin"; glyph=󰖟 ;;
+edge) browser="edge"; package="microsoft-edge-stable-bin"; desktop_id="microsoft-edge.desktop"; name="Edge"; glyph=󰇩 ;;
+firefox) browser="firefox"; package="firefox"; desktop_id="firefox.desktop"; name="Firefox"; glyph=󰈹 ;;
+zen) browser="zen"; package="zen-browser-bin"; desktop_id="app.zen_browser.zen.desktop"; name="Zen"; glyph=󰖟 ;;
 *)
   echo "Usage: omarchy-default-browser <chromium|chrome|brave|brave-origin|edge|firefox|zen>"
   exit 1
   ;;
 esac
 
-if omarchy-cmd-missing "$command"; then
+# omarchy-ubuntu: check the package, not a command: Brave runs as brave-browser and Zen is a Flatpak
+# (layer/lib/pkg-names.sh maps these Arch names to what Ubuntu installs).
+if ! omarchy-pkg-present "$package"; then
   if [[ $installing == "false" ]]; then
     exec omarchy-launch-floating-terminal-with-presentation omarchy-default-browser --install "$browser"
   else
diff --git a/bin/omarchy-remove-browser b/bin/omarchy-remove-browser
index 4c7f7ba..abe3182 100755
--- a/bin/omarchy-remove-browser
+++ b/bin/omarchy-remove-browser
@@ -60,7 +60,7 @@ firefox)
   ;;
 zen)
   echo "Removing Zen..."
-  set_fallback_default_browser zen.desktop
+  set_fallback_default_browser app.zen_browser.zen.desktop
   omarchy-pkg-drop zen-browser-bin
   ;;
 *)
