   M.reconcile()
 end)
 
+-- Hyprland reports a new monitor from inside its connect, before the monitor can
+-- be rendered to. Moving focus there pulls in the monitor's render resources, and
+-- when the session isn't active yet (a dock seen while waking from suspend) that
+-- aborts Hyprland. Reconcile once the connect has returned and the session is back.
 hl.on("monitor.added", function(monitor)
-  M.reconcile(monitor and monitor.name)
+  local name = monitor and monitor.name
+  hl.timer(function()
+    M.reconcile(name)
+  end, { type = "oneshot", timeout = 1000 })
 end)
 
