diff --git i/bin/omarchy w/bin/omarchy
index 3f812df..4d5cf32 100755
--- i/bin/omarchy
+++ w/bin/omarchy
@@ -3,6 +3,12 @@
 set -o pipefail
 
 OMARCHY_BIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+
+# Omarchy on Ubuntu: commands come from PATH, where the Ubuntu layer's versions go first. Routing, help and the
+# metadata check all use the version that runs.
+command_path() {
+  command -v -- "$1" || echo "$OMARCHY_BIN_DIR/$1"
+}
 METADATA_SCAN_LIMIT=80
 
 COMMAND_KEYS=()
@@ -253,7 +259,7 @@ register_command() {
         fallback_summary=""
       fi
     fi
-  done <"$file"
+  done <"$(command_path "$file_binary")"
 
   local stem="${file_binary#omarchy-}"
   local fallback_group="$stem"
@@ -772,7 +778,7 @@ show_commands_check() {
       done < <(pipe_values_as_lines "${COMMAND_METADATA_ERRORS[$key]}")
     fi
 
-    if [[ ! -x $OMARCHY_BIN_DIR/${COMMAND_BINARY[$key]} ]]; then
+    if [[ ! -x $(command_path "${COMMAND_BINARY[$key]}") ]]; then
       echo "Missing binary: ${COMMAND_BINARY[$key]}" >&2
       failures=$((failures + 1))
     fi
@@ -1007,7 +1013,7 @@ dispatch_fast_or_help() {
 
   if resolve_direct_route "$#" "${args[@]}"; then
     remaining=("${args[@]:DIRECT_RESOLVED_COUNT}")
-    binary_path="$OMARCHY_BIN_DIR/$DIRECT_RESOLVED_BINARY"
+    binary_path=$(command_path "$DIRECT_RESOLVED_BINARY")
 
     if (( ${#remaining[@]} == 1 || ${#remaining[@]} == 2 )) && [[ ${remaining[0]} != -* ]] &&
       { (( ${#remaining[@]} == 1 )) || remaining_has_help_flag "${remaining[1]}"; } &&
@@ -1102,7 +1108,7 @@ dispatch_or_help() {
       return 0
     fi
 
-    binary_path="$OMARCHY_BIN_DIR/${COMMAND_BINARY[$key]}"
+    binary_path=$(command_path "${COMMAND_BINARY[$key]}")
     if [[ ! -x $binary_path ]]; then
       echo "Binary is missing or not executable: ${COMMAND_BINARY[$key]}" >&2
       return 127
