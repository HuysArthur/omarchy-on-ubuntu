# Environment for the "Hyprland (Omarchy)" session, sourced by uwsm at login.
# Changes require logging out and back in.

export OMARCHY_PATH="$HOME/.local/share/omarchy"
export PATH="$HOME/.local/share/omarchy-ubuntu/bin:/opt/hyprland/bin:$OMARCHY_PATH/bin:$PATH:$HOME/.local/bin"

# Separate GNOME settings database for this session, so Omarchy's theme/dark-mode/font
# changes never reach the regular Ubuntu (GNOME) session. Stored in ~/.config/dconf/hyprland.
export DCONF_PROFILE="$HOME/.config/dconf/hyprland.profile"

# Omarchy's coding agents: mise reads Omarchy's tool and account config (Arch: /etc/mise/conf.d) as its system
# config in this session only. mise's shims and command wrappers follow its config, so this session keeps its
# own (MISE_DATA_DIR): a reshim in GNOME, which doesn't see Omarchy's config, would otherwise delete the
# agents' shims, and GNOME would get shims for tools it has no version of. What mise installs, downloads and
# its plugins stay shared with GNOME, wherever your mise keeps them. Omarchy's config puts the shims of its lazy
# tools in system_shims_dir, ~/.local/share/mise/shims (GNOME's on Ubuntu), so MISE_SYSTEM_SHIMS_DIR, which
# overrides it, moves those here too. The wrappers (agent accounts) go first on PATH, the shims (the agents,
# installed on first run) after the system's, as in Omarchy's env-bootstrap.
mise_shared="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}"
export MISE_INSTALLS_DIR="${MISE_INSTALLS_DIR:-$mise_shared/installs}"
export MISE_DOWNLOADS_DIR="${MISE_DOWNLOADS_DIR:-$mise_shared/downloads}"
export MISE_PLUGINS_DIR="${MISE_PLUGINS_DIR:-$mise_shared/plugins}"
unset mise_shared
export MISE_DATA_DIR="$HOME/.local/state/omarchy-ubuntu/mise"
export MISE_SYSTEM_SHIMS_DIR="$MISE_DATA_DIR/system-shims"
export MISE_SYSTEM_CONFIG_DIR="$OMARCHY_PATH/etc/mise"
export OMARCHY_MISE_CONFIG_PATH="$MISE_SYSTEM_CONFIG_DIR/conf.d/omarchy-tools.toml"
export PATH="$MISE_DATA_DIR/command-wrappers/bin:$PATH:$MISE_DATA_DIR/shims:$MISE_SYSTEM_SHIMS_DIR"

# Launchers and icons of Omarchy's apps from the Hyprland package (Disktree, Hype, Omacalc, ...). Only this
# session looks in /opt/hyprland/share, so they don't show up in GNOME.
export XDG_DATA_DIRS="/opt/hyprland/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

[ -f "$OMARCHY_PATH/default/uwsm/default" ] && . "$OMARCHY_PATH/default/uwsm/default"
[ -f "$HOME/.config/uwsm/default" ] && . "$HOME/.config/uwsm/default"

# uwsm exports the XDG base-dir vars (with their default values) to the whole session.
# Snaps only remap $HOME into ~/snap/<app>, so an explicit XDG_CONFIG_HOME=~/.config makes
# snaps like Slack and Firefox write to the real ~/.config, which AppArmor denies and the
# app exits without a window. Unset, everything falls back to the same defaults anyway.
unset XDG_CONFIG_HOME XDG_DATA_HOME XDG_CACHE_HOME XDG_STATE_HOME
