# Pinned to what Hyprland's flake.lock uses for the given tag.
# To bump: change HYPRLAND_TAG, then copy the revs from
# https://github.com/hyprwm/Hyprland/blob/<tag>/flake.lock
HYPRLAND_TAG=v0.57.1
PKG_REVISION=1

WAYLAND_PROTOCOLS_TAG=1.49
WAYLAND_SCANNER_TAG=1.26.0
HYPRWAYLAND_SCANNER_REV=62e62c1ca23da17612c6890d4ad2064f575643db
HYPRUTILS_REV=7e1f69209cd910615d0573a93fa970408f643539
HYPRLANG_REV=9508458be316a0d70d37ebed1ab725ccd10411ff
HYPRCURSOR_REV=e4ed7c08123df5af460a0a70961380cbfb872f76
HYPRGRAPHICS_REV=ade4ef0a887d2740efb9c9af2ddb175633365e1b
AQUAMARINE_REV=ad4484335fc327a6cf010f455ae258c397861ee0
HYPRWIRE_REV=a546e42d45e161682f729ebf52375bd4800d7041
HYPRLAND_PROTOCOLS_REV=cd1aba6bd78775825eb230b3a4274c48b6705eb7

# Omarchy 4.5 ships Quickshell 0.3.2 plus fixes up to this commit (its omarchy-pkgs quickshell package), among
# them following Hyprland workspace id changes, which Omarchy's workspace layouts use.
QUICKSHELL_REV=2b4501a282689792b62e94f3fb30d8f512324fe6

# Text effects for Omarchy's screensaver; not in Ubuntu's archive.
TTFX_TAG=v0.5.1

# Omarchy's screenshot tool (Omarchy >= 4.5); not in Ubuntu's archive.
OMASNAP_TAG=v1.25.0

# Omarchy's wallpaper engine (video backgrounds, theme intros) and lock-screen video module (owe-lockfeed).
OWE_TAG=v0.2.13

# Omarchy's floating-workspace titlebars, a Hyprland plugin (built against HYPRLAND_TAG above).
TITLEBARS_TAG=v0.3.0
