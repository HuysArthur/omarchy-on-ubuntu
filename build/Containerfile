FROM docker.io/library/ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential g++-16 cmake ninja-build meson pkg-config git ca-certificates curl python3 \
    dpkg-dev file binutils \
    libwayland-dev libwayland-bin libinput-dev libxkbcommon-dev libdrm-dev libgbm-dev \
    libegl-dev libgles-dev libgl-dev libopengl-dev libpixman-1-dev libcairo2-dev \
    libpango1.0-dev libglib2.0-dev libudev-dev libseat-dev libdisplay-info-dev hwdata \
    liblua5.5-dev libei-dev libeis-dev libre2-dev libmuparser-dev liblcms2-dev glslang-dev glslang-tools \
    libpugixml-dev libtomlplusplus-dev libzip-dev libffi-dev libsdbus-c++-dev uuid-dev \
    libxcursor-dev librsvg2-dev libmagic-dev libjpeg-dev libwebp-dev libpng-dev libspng-dev \
    libjxl-dev libheif-dev \
    libxcb1-dev libxcb-render0-dev libxcb-xfixes0-dev libxcb-icccm4-dev \
    libxcb-composite0-dev libxcb-res0-dev libxcb-errors-dev libexpat1-dev \
    qt6-base-dev qt6-base-private-dev qt6-declarative-dev qt6-declarative-private-dev \
    qt6-wayland-dev qt6-wayland-private-dev qt6-shadertools-dev qt6-svg-dev spirv-tools \
    libcli11-dev libpipewire-0.3-dev libpam0g-dev libpolkit-agent-1-dev libpolkit-gobject-1-dev \
    libjemalloc-dev libvulkan-dev \
 && rm -rf /var/lib/apt/lists/*
