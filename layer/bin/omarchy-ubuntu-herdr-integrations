#!/bin/bash
# Installs herdr's status and session-restore integration for the coding agents you use, however you installed
# them (mise's shims or an agent's own installer, like Claude Code's native one). Omarchy doesn't set this up.
#
# An agent counts once its config folder exists, which it makes on first run: agents you haven't used get it
# the next time this runs (install.sh, omarchy-update). It never touches an integration you installed yourself;
# the ones it installs are listed in ~/.local/state/omarchy-ubuntu/herdr-integrations and kept current. One you
# remove with herdr integration uninstall stays on that list, which keeps it from coming back.
# The hooks do nothing outside herdr, so GNOME, which shares these folders, isn't affected.
#   omarchy-ubuntu-herdr-integrations           install or update
#   omarchy-ubuntu-herdr-integrations --remove  uninstall the ones it installed (uninstall.sh)
set -uo pipefail

LIST=$HOME/.local/state/omarchy-ubuntu/herdr-integrations

herdr=$(command -v herdr || echo "$HOME/.local/bin/herdr")
[[ -x $herdr ]] || exit 0

if [[ ${1:-} == --remove ]]; then
  [[ -f $LIST ]] || exit 0
  while IFS= read -r target; do
    "$herdr" integration uninstall "$target" >/dev/null 2>&1 ||
      echo "Could not remove the herdr integration for $target" >&2
  done <"$LIST"
  rm -f "$LIST"
  exit 0
fi

# Omarchy's agents: herdr target and the folder the agent makes.
config=$HOME/.config
targets=(
  "claude ${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
  "codex ${CODEX_HOME:-$HOME/.codex}"
  "opencode $config/opencode"
  "pi $HOME/.pi/agent"
  "omp $HOME/.omp/agent"
  "grok ${GROK_HOME:-$HOME/.grok}"
  "copilot $HOME/.copilot"
  "cursor $HOME/.cursor"
  "qwen $HOME/.qwen"
  "antigravity-cli $HOME/.gemini/config"
  "devin $config/devin"
  "kilo $config/kilo"
  "kimi $HOME/.kimi-code"
)

status=$("$herdr" integration status 2>/dev/null) || exit 0
mkdir -p "$(dirname "$LIST")"
touch "$LIST"

for entry in "${targets[@]}"; do
  target=${entry%% *} dir=${entry#* }
  [[ -d $dir ]] || continue
  # herdr prints "<target>: not installed (...)" or "<target>: current (v11) (...)"; older herdr may not know it.
  state=$(grep -m1 "^$target: " <<<"$status") || continue
  listed=
  grep -qxF "$target" "$LIST" && listed=1
  case $state in
  "$target: current"*) continue ;;
  "$target: not installed"*) [[ -z $listed ]] || continue ;; # you removed it
  *) [[ -n $listed ]] || continue ;;                         # yours
  esac
  # herdr reports to stdout; keep it quiet, and only warn on failure.
  if "$herdr" integration install "$target" >/dev/null; then
    grep -qxF "$target" "$LIST" || echo "$target" >>"$LIST"
  else
    echo "Could not install the herdr integration for $target" >&2
  fi
done
exit 0
