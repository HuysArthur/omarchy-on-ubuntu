#!/bin/bash
# omarchy:summary=Reset Omarchy user configs to shipped defaults (backs up your versions)
# Ubuntu version of Omarchy's command, which copies /etc/skel over your home. Here the shipped defaults are the
# config files install.sh seeds for the Omarchy session: this puts Omarchy's (or omarchy-ubuntu's) default back for
# each of them, and backs yours up first: to ~/.local/state/omarchy-ubuntu/reset-backup/<time>/, or, for a file
# you had before the install, to backup/<time>/, which uninstall.sh restores. Apps GNOME shares
# (ghostty, btop, ...) and config files Omarchy doesn't ship are left alone.
set -euo pipefail

if ((EUID == 0)); then
  echo "Error: This script should not be run as root" >&2
  exit 1
fi

# shellcheck source=../lib/configs.sh
. "$HOME/.local/share/omarchy-ubuntu/lib/configs.sh"
RESET_CONFIGS=1

echo "Resetting Omarchy user configs to shipped defaults (your versions are backed up)..."
for f in "${OWN_CONFIGS[@]}"; do
  put "$LAYER/config/$f" "$C/$f"
done
seed_configs
# The speaker-tuning drop-in may have been put back.
systemctl --user daemon-reload 2>/dev/null || true

if ((${#RESET_BACKED_UP[@]} + ${#BACKED_UP[@]} == 0)); then
  echo "Done. Everything was already at its default; nothing was replaced."
  exit 0
fi
echo "Done."
((${#RESET_BACKED_UP[@]} == 0)) || echo "Your versions of ${#RESET_BACKED_UP[@]} file(s) are in $RESET_BACKUP."
# Files you had before the install (install.sh left them alone) are kept where uninstall.sh restores them from.
((${#BACKED_UP[@]} == 0)) || echo "Your pre-install versions of ${#BACKED_UP[@]} file(s) are in $BACKUP."
