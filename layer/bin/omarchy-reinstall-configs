#!/bin/bash
# omarchy:summary=Reset Omarchy user configs to shipped defaults (backs up your versions)
# Ubuntu version of Omarchy's command, which copies /etc/skel over your home. Here the shipped defaults are the
# config files install.sh seeds for the Omarchy session: this puts Omarchy's (or omarchy-ubuntu's) default back for
# each of them, and backs yours up to ~/.local/state/omarchy-ubuntu/reset-backup/<time>/ first. Apps GNOME shares
# (ghostty, btop, ...) and config files Omarchy doesn't ship are left alone.
set -euo pipefail

if ((EUID == 0)); then
  echo "Error: This script should not be run as root" >&2
  exit 1
fi

# shellcheck source=../lib/configs.sh
. "$HOME/.local/share/omarchy-ubuntu/lib/configs.sh"
RESET_CONFIGS=1

echo "Resetting Omarchy user configs to shipped defaults (your versions are backed up)..."
for f in "${OWN_CONFIGS[@]}"; do
  put "$LAYER/config/$f" "$C/$f"
done
seed_configs
echo "Done. Replaced files are in $RESET_BACKUP."
