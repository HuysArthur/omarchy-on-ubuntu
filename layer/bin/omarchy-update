#!/bin/bash
# Ubuntu replacement for Omarchy's pacman/AUR update. Omarchy itself stays pinned; see docs/development.md.
# Also brings omarchy-ubuntu up to date on its channel (omarchy-channel-set update).
if [[ ! -t 1 ]]; then
  exec omarchy-launch-floating-terminal-with-presentation omarchy-update "$@"
fi
set -e
sudo apt update
if [[ ${1:-} == -y ]]; then sudo apt full-upgrade -y; else sudo apt full-upgrade; fi
command -v flatpak >/dev/null && flatpak update -y || true
# The coding agents and other tools mise installed (Omarchy's own step; does nothing without mise).
omarchy-update-mise || echo "mise tools were not updated (see above)."
echo
omarchy-channel-set update || echo "omarchy-ubuntu was not updated (see above)."
# herdr's integration for agents you've started using since (does nothing without herdr). After the update, so
# it's the new layer's version with its list of agents.
"$HOME/.local/share/omarchy-ubuntu/bin/omarchy-ubuntu-herdr-integrations"
# A newer pinned Omarchy brings new migrations; run them now rather than at the next login.
omarchy-migrate --restart-shell || true
echo
read -n 1 -s -r -p "Done. Press any key to close."
