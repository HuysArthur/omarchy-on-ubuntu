#!/bin/bash
# Ubuntu replacement for Omarchy's pacman/AUR update. Omarchy itself stays pinned; see omarchy-ubuntu's README.
# Also brings omarchy-ubuntu up to date on its channel (omarchy-channel-set update).
if [[ ! -t 1 ]]; then
  exec omarchy-launch-floating-terminal-with-presentation omarchy-update "$@"
fi
set -e
sudo apt update
if [[ ${1:-} == -y ]]; then sudo apt full-upgrade -y; else sudo apt full-upgrade; fi
command -v flatpak >/dev/null && flatpak update -y || true
echo
omarchy-channel-set update || echo "omarchy-ubuntu was not updated (see above)."
echo
read -n 1 -s -r -p "Done. Press any key to close."
