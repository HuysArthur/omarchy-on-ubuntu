#!/bin/bash
# Removes the named packages with apt if they're installed (otherwise ignores them), like Omarchy's pacman version.
# Arch names of apps that Ubuntu gets elsewhere (browsers, see lib/pkg-names.sh) remove what was installed instead.

# shellcheck source=../lib/pkg-names.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/pkg-names.sh"

as_root() { if ((EUID == 0)); then "$@"; else sudo "$@"; fi; }

installed=()
flatpaks=()
vendors=()
for p in "$@"; do
  pkg_installed "$p" || continue
  src=$(pkg_source "$p")
  case $src in
  deb:*) installed+=("${src#deb:}") ;;
  flatpak:*) flatpaks+=("${src#flatpak:}") ;;
  vendor:*) vendors+=("${src#vendor:}") ;;
  esac
done

if ((${#installed[@]})); then
  # pacman -Rns refuses when another package needs one of these; apt-get remove -y would remove that package too
  # (on Ubuntu often part of GNOME). Ask apt what it would remove and refuse the same way.
  sim=$(LC_ALL=C apt-get -s remove -- "${installed[@]}" 2>&1) || { echo "$sim" >&2; exit 1; }
  extra=()
  while read -r verb name _; do
    [[ $verb == Remv ]] || continue
    name=${name%%:*}
    [[ " ${installed[*]} " == *" $name "* ]] || extra+=("$name")
  done <<<"$sim"
  if ((${#extra[@]})); then
    echo "Not removing ${installed[*]}: apt would also remove what needs it: ${extra[*]}" >&2
    exit 1
  fi
  as_root apt-get remove -y -- "${installed[@]}" || exit 1
fi

if ((${#flatpaks[@]})); then
  as_root flatpak uninstall -y --noninteractive "${flatpaks[@]}" || exit 1
fi

for vendor in "${vendors[@]}"; do
  "$PKG_LIBEXEC/$vendor" remove || exit 1
done
exit 0
