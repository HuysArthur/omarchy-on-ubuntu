#!/bin/bash
# Install > Package: a fuzzy-finder TUI over Ubuntu's apt packages (Omarchy's picks from pacman's repos).
# With package names it installs those instead, like omarchy-pkg-add.
if (($#)); then
  exec omarchy-pkg-add "$@"
fi

fzf_args=(
  --multi
  --preview 'apt-cache show {1} 2>/dev/null | grep -v "^ \."'
  --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:green,marker:green'
)

mapfile -t pkg_names < <(apt-cache pkgnames | sort | fzf "${fzf_args[@]}")

if ((${#pkg_names[@]})); then
  sudo apt-get install -- "${pkg_names[@]}"
  omarchy-show-done
fi
