#!/bin/bash
# Ubuntu replacement: switch the omarchy-ubuntu checkout to main ("stable") or an open pull request,
# then re-run install.sh. Going back to stable removes what the pull request installed.
#   omarchy-channel-set stable | pr [<number>] | update
# update (run by omarchy-update) pulls the current channel and re-installs only when it changed; a pull
# request that has been merged or closed goes back to stable.
set -euo pipefail

STATE=$HOME/.local/state/omarchy-ubuntu

# Set by checkout until install.sh starts, so a failed check goes back to the branch it came from.
previous=

fail() {
  echo "$1" >&2
  [[ -z $previous ]] || git checkout -q "$previous"
  omarchy-notification-send -u critical "omarchy-ubuntu not updated" "$1" >/dev/null 2>&1 || true
  exit 1
}

REPO=$(cat "$STATE/repo" 2>/dev/null) || true
[[ -n $REPO && -d $REPO/.git ]] || fail "No omarchy-ubuntu checkout found. Run install.sh from one first."
cd "$REPO"

# checkout stable | checkout pr <number>
checkout() {
  [[ -z $(git status --porcelain) ]] || fail "$REPO has uncommitted changes. Commit or stash them first."
  previous=$(git branch --show-current)
  if [[ $1 == stable ]]; then
    git checkout -q main
    git pull -q --ff-only
  else
    gh pr checkout "$2"
  fi
}

# install.sh downloads the release for build/versions.env, which the Package workflow publishes. When that
# build is still running, offer to wait for it.
check_package() {
  local HYPRLAND_TAG PKG_REVISION v run
  # shellcheck disable=SC1091
  . build/versions.env
  v=${HYPRLAND_TAG#v}-$PKG_REVISION
  compgen -G "dist/hyprland-opt_$v[~_]ubuntu26.04_amd64.deb" >/dev/null && return 0
  run=$(gh run list --workflow package.yml --branch "$(git branch --show-current)" --limit 1 \
    --json databaseId,status -q '.[] | select(.status != "completed") | .databaseId' 2>/dev/null) || true
  if [[ -n $run ]]; then
    echo "hyprland-opt $v is being built on GitHub."
    gum confirm "Wait for it? A full build takes about an hour." || fail "hyprland-opt $v is still being built."
    gh run watch "$run" --exit-status >/dev/null || fail "The hyprland-opt $v build failed: gh run view $run --log-failed"
  fi
  gh release view "hyprland-opt-$v" >/dev/null 2>&1 && return 0
  fail "hyprland-opt $v isn't built: the Package workflow builds it when build/ changes (or run ./build.sh)."
}

# reinstall <channel> <notification title>
reinstall() {
  check_package
  previous=
  OMARCHY_UBUNTU_CHANNEL=$1 ./install.sh
  omarchy-notification-send "$2" \
    "Session environment changes apply after you log out and back in." >/dev/null 2>&1 || true
}

case ${1:-} in
  stable | update) ;;
  pr)
    if [[ -z ${2:-} ]]; then
      # Pick from the open pull requests in the menu, then come back here in a terminal.
      current=$(omarchy-channel-current)
      prs=$(gh pr list --json number,title,isDraft \
        --jq '.[] | "\(.number)\t\(.title)\(if .isDraft then " (draft)" else "" end)"') \
        || fail "Could not list pull requests (is gh logged in?)."
      [[ -n $prs ]] || fail "There are no open pull requests."
      options=()
      while IFS=$'\t' read -r number title; do
        [[ $current == "pr-$number" ]] && glyph=✓ || glyph=
        options+=("$glyph"$'\t'"#$number $title")
      done <<<"$prs"
      choice=$(omarchy-menu-select "Pull request" "${options[@]}" -- --width 640) || exit 0
      number=${choice%% *}
      exec omarchy-launch-floating-terminal-with-presentation "omarchy-channel-set pr ${number#\#}"
    fi
    [[ $2 =~ ^[0-9]+$ ]] || fail "Not a pull request number: $2"
    ;;
  *) fail "Usage: omarchy-channel-set stable | pr [<number>] | update" ;;
esac

if [[ ! -t 1 ]]; then
  exec omarchy-launch-floating-terminal-with-presentation "omarchy-channel-set $*"
fi

if [[ $1 == update ]]; then
  current=$(omarchy-channel-current)
  if [[ $current == pr-* ]]; then
    state=$(gh pr view "${current#pr-}" --json state -q .state) || fail "Could not look up PR #${current#pr-}."
    if [[ $state == OPEN ]]; then
      set -- pr "${current#pr-}"
    else
      echo "PR #${current#pr-} is ${state,,}, going back to Stable."
      set -- stable
    fi
  else
    set -- stable
  fi
  channel=$1${2:+-$2}
  checkout "$@"
  if [[ $channel == "$current" && $(git rev-parse HEAD) == "$(cat "$STATE/commit" 2>/dev/null)" ]]; then
    echo "omarchy-ubuntu is up to date."
    exit 0
  fi
  reinstall "$channel" "omarchy-ubuntu updated"
  exit 0
fi

if [[ $1 == stable ]]; then
  checkout stable
  reinstall stable "Now on Stable"
else
  checkout pr "$2"
  # A branch from before channel support doesn't track its files, so stable couldn't remove them later.
  if ! grep -q '^MANAGED=' install.sh; then
    echo "This pull request predates channel switching: going back to Stable won't remove what it installs."
    echo "Rebase it onto main to fix that."
    gum confirm "Install it anyway?" || { git checkout -q main; exit 130; }
  fi
  reinstall "pr-$2" "Now on PR #$2"
fi
