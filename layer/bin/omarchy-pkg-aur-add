#!/bin/bash
# Omarchy installs a few apps from the AUR (Install > Browser). Ubuntu has no AUR, so these come from where
# their vendors publish them for Ubuntu: Chrome and Edge as the vendor's .deb (which adds the vendor's apt
# repository, so apt keeps them updated), Brave from Brave's apt repository, Zen from Flathub.
# Anything else isn't available. Returns false if a package couldn't be added, like Omarchy's version.

installed() { dpkg-query -W -f='${db:Status-Abbrev}' "$1" 2>/dev/null | grep -q '^ii'; }

# vendor_deb URL: install a vendor's .deb with apt, which also pulls in its dependencies.
vendor_deb() {
  local dir rc
  dir=$(mktemp -d)
  curl -fL --progress-bar -o "$dir/package.deb" "$1" && sudo apt-get install -y "$dir/package.deb"
  rc=$?
  rm -rf "$dir"
  return $rc
}

brave_repo() {
  local keyring=/usr/share/keyrings/brave-browser-archive-keyring.gpg
  local list=/etc/apt/sources.list.d/brave-browser-release.list
  if [[ ! -f $list ]]; then
    sudo curl -fsSLo "$keyring" https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg || return 1
    echo "deb [signed-by=$keyring] https://brave-browser-apt-release.s3.brave.com/ stable main" |
      sudo tee "$list" >/dev/null
  fi
  sudo apt-get update -q
}

flathub_app() {
  flatpak info "$1" >/dev/null 2>&1 && return 0
  sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo &&
    sudo flatpak install -y --noninteractive flathub "$1"
}

for pkg in "$@"; do
  case $pkg in
  google-chrome)
    installed google-chrome-stable || vendor_deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
    ;;
  microsoft-edge-stable-bin)
    installed microsoft-edge-stable || vendor_deb 'https://go.microsoft.com/fwlink?linkid=2149051&brand=M102'
    ;;
  brave-bin)
    installed brave-browser || { brave_repo && sudo apt-get install -y brave-browser; }
    ;;
  brave-origin-bin)
    installed brave-origin || { brave_repo && sudo apt-get install -y brave-origin; }
    ;;
  zen-browser-bin)
    flathub_app app.zen_browser.zen
    ;;
  *)
    echo "$pkg comes from the AUR, which isn't available on Ubuntu." >&2
    false
    ;;
  esac || exit 1
done
